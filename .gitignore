# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# compiler and package-manager caches
*.tsbuildinfo
/.pnpm-store/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/

# local Codex/design-tool state and visual review captures
/.freebuff/
/.impeccable/

# local voice reference (never commit reference audio)
/voice-reference/*
!/voice-reference/README.md

# raw media and locally generated voice material
*.wav
*.mp3
*.m4a
*.flac
*.mp4
*.mov

# scratch audio-processing workspace
/.work/
